rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Match any document in the projects collection
    match /projects/{projectId} {
      // Anyone can read projects to view the portfolio
      allow read: if true;
      
      // Only authenticated users can write (create, update, delete) projects
      allow write: if request.auth != null;
    }

    // Match any document in the stats collection
    match /stats/{statId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Match any document in the solutions collection
    match /solutions/{solutionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Match any document in the testimonials collection
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Match any document in the pricing collection
    match /pricing/{pricingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
